# Use the debina13-slim
FROM debian:13-slim AS builder

# disable the interactive message
ENV DEBIAN_FRONTEND=noninteractive

# Install the dependancy for wxPython (based on GTK3 on linux)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-dev \
    python3-pip \
    build-essential \
    libgtk-3-dev \
    libwebkit2gtk-4.1-dev \
    libjpeg-dev \
    libtiff-dev \
    libnotify-dev \
    freeglut3-dev \
    libsdl2-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# build the wheel when starting the container
CMD pip wheel wxPython~=4.2 --wheel-dir=/build/wheels --no-cache-dir