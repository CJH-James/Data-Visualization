# [Ignore] third_party build files
third_party/*
!third_party/*.md
!third_party/dockerfile*

# [Ignore] Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# [Ignore] Python Virtual environments
.venv
# [Ignore] uv lock files
uv.lock
uv.lock.*

# [Ignore] doxygen files
doc/html/*
doc/latex/*
